{
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    { "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }] }
  ]
}
